# ── Groq proxy ────────────────────────────────────────────────────────────────
# URL of the Cloudflare Worker that proxies Groq API calls.
# Local dev:  http://localhost:8787  (wrangler dev)
# Production: https://summify-proxy.<your-subdomain>.workers.dev
VITE_PROXY_URL=

# LLM model (optional — defaults to llama-3.3-70b-versatile)
VITE_OPENROUTER_MODEL=llama-3.3-70b-versatile

# To deploy the worker:
#   1. npm install -g wrangler
#   2. wrangler login
#   3. wrangler secret put GROQ_API_KEY   ← paste your key here, never in this file
#   4. wrangler deploy

# ── Firebase ──────────────────────────────────────────────────────────────────
# Get these from Firebase Console → Project Settings → Your apps → SDK snippet
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
