# ═══════════════════════════════════════════════════════════════════
#  Summify — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit the real .env file (it is in .gitignore).
# ═══════════════════════════════════════════════════════════════════

# ── AI Proxy ───────────────────────────────────────────────────────
#
#  Option A — Vercel deployment (default, no extra infra needed):
#    Set VITE_PROXY_URL=/api/proxy in Vercel env vars dashboard.
#    Also add GROQ_API_KEY (server-side, no VITE_ prefix) in Vercel.
#
#  Option B — Cloudflare Worker:
#    Deploy the worker: npm run worker:deploy
#    Then set VITE_PROXY_URL to your worker URL below.
#
#  Local dev (runs both vite + wrangler):
VITE_PROXY_URL=http://localhost:8787

# LLM model — defaults to llama-3.3-70b-versatile if unset
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# ── Firebase (public config — safe to expose) ──────────────────────
#  Find these in: Firebase console → Project settings → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
